//-----------------------------------------------------------------------------
//	CLIENT_HL2SB.VPC
//
//	Dedicated project script for HL2SB (Lua sandbox multiplayer).
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"hl2sb" [!$SOURCESDK]
$Macro GAMENAME 	"mod_hl2sb" [$SOURCESDK]

$Include "$SRCDIR\game\client\client_base.vpc"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories		"hl2mp\ui;.\hl2mp;$SRCDIR\game\shared\hl2mp;.\hl2;.\hl2\elements;$SRCDIR\game\shared\hl2;$SRCDIR\game\shared\episodic;..\..\public\;.\lua;.\lua\scripted_controls;.\hl1;$SRCDIR\game\shared\hl1"
		$PreprocessorDefinitions			"HL2MP;HL2_CLIENT_DLL;HL2SB;ARGG;LUA_SDK"
	}
}

$Project "Client (HL2SB)"
{
